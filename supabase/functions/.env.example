# Copy to supabase/functions/.env for local development only.
# Never commit the real .env file or place OPENAI_API_KEY in browser code.
OPENAI_API_KEY=
OPENAI_MODEL=
MOTOVICH_ALLOWED_ORIGIN=https://dmwwiin-beep.github.io

# Web Push sending keys. Generate a VAPID key pair; only the public key goes in the app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Use a cryptographically random secret of at least 32 bytes for scheduled delivery.
MOTOVICH_PUSH_CRON_SECRET=
# Required by the push-send function; never expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=
